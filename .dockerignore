# Every service builds with the repo root as context, so this is the only
# .dockerignore that applies.

.git/
.github/
.claude/

node_modules/
**/node_modules/
**/.next/
**/dist/
**/build/
coverage/

**/.venv/
**/__pycache__/
**/*.pyc
**/.pytest_cache/
**/tests/
**/requirements-dev.txt

# Never build a secret into an image. .env.example is the only one that ships.
.env
.env.*
!.env.example

kubernetes/
terraform/
docs/

**/.DS_Store
*.log
*.md
!README.md
# The RAG corpus is markdown and ai-service copies it into the image. Without
# this the image builds fine and answers nothing.
!rag/knowledge-base/**/*.md
