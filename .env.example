# Copy to .env at the repo root, and to frontend/.env.local — Next.js only
# reads env files from its own directory. Both are gitignored.

# Database — Postgres with pgvector. Local dev uses the compose service.
DATABASE_URL=postgres://skillforge:dev@localhost:5432/skillforge

# Compose builds DATABASE_URL from these; nothing outside docker-compose.yml
# reads them. No defaults on purpose — an unset value fails the container
# rather than starting it with a well-known password.
POSTGRES_USER=skillforge
POSTGRES_PASSWORD=dev
POSTGRES_DB=skillforge

# Auth (auth-service)
BETTER_AUTH_SECRET=replace-me-openssl-rand-base64-32-gives-44-chars
# The origin the *browser* sees, not the service's own port: Caddy in compose,
# the Next dev server locally. Better Auth signs cookies for this origin.
BETTER_AUTH_URL=http://localhost:3000
# Extra origins allowed to call the auth endpoints, comma-separated.
TRUSTED_ORIGINS=
# CIDRs of proxies allowed to set X-Forwarded-For. Without it the login rate
# limiter cannot resolve a real client IP behind Caddy and every client shares
# one bucket. Empty in local dev, where there is no proxy.
TRUSTED_PROXIES=
# Set to true only to run over plain HTTP — a Secure cookie is never sent back
# over http, so leaving this unset breaks sign-in on a non-TLS host.
AUTH_INSECURE_COOKIES=true

# The gateway is the only hop allowed to assert who the caller is. Services
# reject identity headers that do not carry this key, so a forged header fails
# closed even if something reaches a service directly.
# Generate with: openssl rand -hex 32
GATEWAY_SECRET=dev-only-gateway-secret-change-me-in-production

# LLM (ai-service). DeepSeek is OpenAI-compatible.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# Embeddings run locally via fastembed; no key needed.
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# Service URLs — the gateway is the only one the frontend talks to.
GATEWAY_URL=http://localhost:8080
AUTH_SERVICE_URL=http://localhost:8081
PROFILE_API_URL=http://localhost:8082
SKILL_SERVICE_URL=http://localhost:8083
AI_SERVICE_URL=http://localhost:8084
PYTHON_ANALYZER_URL=http://localhost:8085

# Uploaded CVs and certificates. Never inside the repo — a forgotten
# .gitignore entry is how an upload ends up committed.
UPLOAD_DIR=/tmp/skillforge-uploads

# Caddy. `localhost` is a real value, not a placeholder: Caddy issues from its
# own internal CA for localhost and IPs, so a clean clone gets working HTTPS
# with no DNS. Point it at a domain for a real deploy.
SITE_ADDRESS=localhost
