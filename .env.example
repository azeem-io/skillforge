# Database — Postgres with pgvector. Local dev uses the compose service.
DATABASE_URL=postgres://skillforge:dev@localhost:5432/skillforge

# Auth (auth-service)
BETTER_AUTH_SECRET=change-me-32-chars-minimum
BETTER_AUTH_URL=http://localhost:3000

# LLM (ai-service). DeepSeek is OpenAI-compatible.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# Embeddings run locally via fastembed; no key needed.
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# Service URLs — the gateway is the only one the frontend talks to.
GATEWAY_URL=http://localhost:8080
AUTH_SERVICE_URL=http://localhost:8081
PROFILE_API_URL=http://localhost:8082
SKILL_SERVICE_URL=http://localhost:8083
AI_SERVICE_URL=http://localhost:8084
PYTHON_ANALYZER_URL=http://localhost:8085
