{
  "name": "skillforge",
  "version": "0.1.0",
  "private": true,
  "description": "AI-powered student skills and career development platform",
  "license": "MIT",
  "workspaces": [
    "packages/*",
    "frontend",
    "backend/*"
  ],
  "scripts": {
    "dev": "bun run --filter @skillforge/frontend dev",
    "build": "bun run --filter @skillforge/frontend build",
    "db:generate": "bun run --filter @skillforge/db generate",
    "db:migrate": "bun run --filter @skillforge/db migrate",
    "db:seed": "bun run --filter @skillforge/db seed",
    "db:studio": "bun run --filter @skillforge/db studio",
    "typecheck": "bun run --filter '*' typecheck"
  }
}
