{
  "name": "@skillforge/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema/index.ts"
  },
  "scripts": {
    "generate": "drizzle-kit generate",
    "migrate": "node --env-file-if-exists=../../.env --experimental-strip-types src/migrate.ts",
    "seed": "node --env-file-if-exists=../../.env --experimental-strip-types src/seed/index.ts",
    "studio": "drizzle-kit studio",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "drizzle-orm": "^0.44.6",
    "postgres": "^3.4.7"
  },
  "devDependencies": {
    "drizzle-kit": "^0.31.5",
    "typescript": "^5.9.3",
    "@types/node": "^24.10.1"
  }
}
