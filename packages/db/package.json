{
  "name": "@skillforge/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema/index.ts"
  },
  "scripts": {
    "generate": "bun --env-file=../../.env x drizzle-kit generate",
    "migrate": "bun --env-file=../../.env src/migrate.ts",
    "seed": "bun --env-file=../../.env src/seed/index.ts",
    "studio": "bun --env-file=../../.env x drizzle-kit studio",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "drizzle-orm": "^0.44.6",
    "postgres": "^3.4.7"
  },
  "devDependencies": {
    "@types/bun": "^1.3.6",
    "drizzle-kit": "^0.31.5",
    "typescript": "^5.9.3"
  }
}
